{
  "name": "steptodo-frontend",
  "private": true,
  "description": "StepTodo 화면 (빌드 없음). package.json은 개발 서버와 테스트 실행용이다.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "serve": "node tests/support/server.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\""
  },
  "devDependencies": {
    "playwright-core": "1.48.2"
  }
}
